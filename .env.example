# RA Interactive — environment variables
# Copy to .env.local and fill in.

# Public site URL (used for canonical URLs, sitemap, OG tags)
NEXT_PUBLIC_SITE_URL=https://rainteractive.com

# Resend — transactional email for the contact form.
# Without this, contact submissions are logged server-side and still succeed.
RESEND_API_KEY=
CONTACT_TO_EMAIL=hello@rainteractive.com
CONTACT_FROM_EMAIL=RA Interactive <noreply@rainteractive.com>
